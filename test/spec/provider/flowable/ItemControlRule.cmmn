<?xml version="1.0" encoding="UTF-8"?>
<cmmn:definitions xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC" xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI" xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:flowable="http://flowable.org/cmmn" id="Test" targetNamespace="http://bpmn.io/schema/cmmn">
  <cmmn:case id="Case_1">
    <cmmn:casePlanModel id="CasePlanModel_1" name="A CasePlanModel">
      <cmmn:planItem id="PI_Task" definitionRef="Task_1">
        <cmmn:itemControl id="ItemControl_1">
          <cmmn:extensionElements>
            <flowable:parentCompletionRule type="ignore" />
            <flowable:completionNeutralRule>
              <cmmn:condition>${vars:getOrDefault('neutral', false)}</cmmn:condition>
            </flowable:completionNeutralRule>
            <flowable:reactivationRule activateCondition="true" />
          </cmmn:extensionElements>
        </cmmn:itemControl>
      </cmmn:planItem>
      <cmmn:planItem id="PI_NoControl" definitionRef="Task_2" />
      <cmmn:planItem id="PI_Empty" definitionRef="Task_3">
        <cmmn:itemControl id="ItemControl_3" />
      </cmmn:planItem>
      <cmmn:planItem id="PI_Default" definitionRef="Task_4" />
      <cmmn:planItem id="PI_Reactivate" definitionRef="EventListener_1" />
      <cmmn:planItem id="PI_Listener" definitionRef="EventListener_2" />
      <cmmn:task id="Task_1" name="With rules" />
      <cmmn:task id="Task_2" name="No control" />
      <cmmn:task id="Task_3" name="Empty control" />
      <cmmn:task id="Task_4" name="Default control">
        <cmmn:defaultControl id="DefaultControl_4">
          <cmmn:extensionElements>
            <flowable:completionNeutralRule />
          </cmmn:extensionElements>
        </cmmn:defaultControl>
      </cmmn:task>
      <cmmn:eventListener id="EventListener_1" name="Reactivate" flowable:eventType="reactivate">
        <cmmn:extensionElements>
          <flowable:defaultReactivationRule ignoreCondition="true" />
        </cmmn:extensionElements>
      </cmmn:eventListener>
      <cmmn:eventListener id="EventListener_2" name="Other" />
    </cmmn:casePlanModel>
  </cmmn:case>
  <cmmndi:CMMNDI>
    <cmmndi:CMMNDiagram id="Diagram_1">
      <cmmndi:CMMNShape id="DI_CasePlanModel_1" cmmnElementRef="CasePlanModel_1">
        <dc:Bounds x="20" y="20" width="620" height="300" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_Task" cmmnElementRef="PI_Task">
        <dc:Bounds x="60" y="60" width="100" height="80" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_NoControl" cmmnElementRef="PI_NoControl">
        <dc:Bounds x="200" y="60" width="100" height="80" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_Empty" cmmnElementRef="PI_Empty">
        <dc:Bounds x="340" y="60" width="100" height="80" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_Default" cmmnElementRef="PI_Default">
        <dc:Bounds x="480" y="60" width="100" height="80" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_Reactivate" cmmnElementRef="PI_Reactivate">
        <dc:Bounds x="80" y="200" width="36" height="36" />
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="DI_PI_Listener" cmmnElementRef="PI_Listener">
        <dc:Bounds x="220" y="200" width="36" height="36" />
      </cmmndi:CMMNShape>
    </cmmndi:CMMNDiagram>
  </cmmndi:CMMNDI>
</cmmn:definitions>
